{
  "multipart": [
    {
      "apply": {
        "model": "boombox:block/velvet_rope_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "boombox:block/velvet_rope_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "boombox:block/velvet_rope_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "boombox:block/velvet_rope_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "boombox:block/velvet_rope_side",
        "y": 270
      }
    }
  ]
}